{
  "name": "ai-novel-production-system-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs tests/contracts/*.test.mjs && vitest run tests/store",
    "test:store": "vitest run tests/store",
    "typecheck": "vue-tsc --noEmit",
    "verify": "node scripts/verify-architecture.mjs && node scripts/verify-module-boundaries.mjs",
    "verify:m0a": "node scripts/verify-m0a-evidence.mjs",
    "verify:boundaries": "node scripts/verify-module-boundaries.mjs",
    "build:demo": "VITE_BROWSER_DEMO=true vite build",
    "contracts:generate": "node contracts/tools/generate-contracts.mjs",
    "contracts:validate": "node contracts/tools/validate-fixtures.mjs",
    "contracts:golden": "node contracts/tools/verify-golden-hash.mjs",
    "contracts:drift-check": "tmp=$(mktemp -d) && trap 'rm -rf \"$tmp\"' EXIT && CONTRACTS_GENERATED_DIR=\"$tmp/ts\" CONTRACTS_RUST_GENERATED_DIR=\"$tmp/rust\" node contracts/tools/generate-contracts.mjs && diff -ru src/generated/contracts \"$tmp/ts\" && diff -ru src-tauri/src/generated/contracts \"$tmp/rust\"",
    "verify:contracts": "npm run contracts:validate && npm run contracts:golden && npm run contracts:drift-check",
    "verify:b03": "node scripts/run-b03-evidence-gates.mjs && node scripts/assemble-b03-evidence.mjs && node scripts/generate-b03-acceptance.mjs",
    "verify:b04": "node scripts/run-b04-evidence-gates.mjs && node scripts/assemble-b04-evidence.mjs && node scripts/generate-b04-acceptance.mjs",
    "verify:b06-h01": "export B06_H01_EVIDENCE_DIR=\"${B06_H01_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b06-h01-evidence.XXXXXX)}\" && node scripts/run-b06-h01-evidence-gates.mjs && node scripts/assemble-b06-h01-evidence.mjs && node scripts/generate-b06-h01-acceptance.mjs",
    "verify:b07-h02": "export B07_H02_EVIDENCE_DIR=\"${B07_H02_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b07-h02-evidence.XXXXXX)}\" && node scripts/run-b07-h02-evidence-gates.mjs && node scripts/generate-b07-h02-acceptance.mjs",
    "verify:b08-h03": "export B08_H03_EVIDENCE_DIR=\"${B08_H03_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b08-h03-evidence.XXXXXX)}\" && node scripts/run-b08-h03-evidence-gates.mjs && node scripts/assemble-b08-h03-evidence.mjs && node scripts/generate-b08-h03-acceptance.mjs",
    "verify:b05": "export B05_EVIDENCE_DIR=\"${B05_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b05-evidence.XXXXXX)}\" && node scripts/run-b05-evidence-gates.mjs && node scripts/assemble-b05-evidence.mjs && node scripts/generate-b05-acceptance.mjs",
    "verify:b09-h04": "node scripts/run-b09-h04-evidence-gates.mjs",
    "verify:b10": "node scripts/run-b10-evidence-gates.mjs",
    "verify:b13": "export B13_R1_EVIDENCE_DIR=\"${B13_R1_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b13-r1-evidence.XXXXXX)}\" && node scripts/run-b13-r1-evidence-gates.mjs && node scripts/generate-b13-r1-acceptance.mjs",
    "package:b13-r1": "node scripts/assemble-b13-r1-package.mjs",
