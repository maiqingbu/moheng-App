  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "^17.6.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
