    "package:b13-r2": "node scripts/assemble-b13-r2-package.mjs",
    "verify:b13-r3": "export B13_R3_EVIDENCE_DIR=\"${B13_R3_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b13-r3-evidence.XXXXXX)}\" && node scripts/run-b13-r3-evidence-gates.mjs",
    "package:b13-r3": "node scripts/assemble-b13-r3-package.mjs",
    "verify:b13-r4": "export B13_R4_EVIDENCE_DIR=\"${B13_R4_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b13-r4-evidence.XXXXXX)}\" && node scripts/run-b13-r4-evidence-gates.mjs",
    "verify:b14": "export B14_EVIDENCE_DIR=\"${B14_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b14-evidence.XXXXXX)}\" && node scripts/run-b14-evidence-gates.mjs",
    "package:b14": "node scripts/assemble-b14-package.mjs",
    "verify:b14-r1": "export B14_R1_EVIDENCE_DIR=\"${B14_R1_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b14-r1-evidence.XXXXXX)}\" && node scripts/run-b14-r1-evidence-gates.mjs",
    "package:b14-r1": "node scripts/assemble-b14-r1-package.mjs",
    "verify:b14-r2": "export B14_R2_EVIDENCE_DIR=\"${B14_R2_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b14-r2-evidence.XXXXXX)}\" && node scripts/run-b14-r2-evidence-gates.mjs",
    "package:b14-r2": "node scripts/assemble-b14-r2-package.mjs",
  "verify:b14-r3": "export B14_R3_EVIDENCE_DIR=\"${B14_R3_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b14-r3-evidence.XXXXXX)}\" && node scripts/run-b14-r3-evidence-gates.mjs",
  "verify:b14-r4": "export B14_R4_EVIDENCE_DIR=\"${B14_R4_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b14-r4-evidence.XXXXXX)}\" && node scripts/run-b14-r4-evidence-gates.mjs",
  "verify:b14-r5": "export B14_R5_EVIDENCE_DIR=\"${B14_R5_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b14-r5-evidence.XXXXXX)}\" && node scripts/run-b14-r5-evidence-gates.mjs",
  "verify:b14-r6": "export B14_R6_EVIDENCE_DIR=\"${B14_R6_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b14-r6-evidence.XXXXXX)}\" && node scripts/run-b14-r6-evidence-gates.mjs",
  "verify:b14-r7": "export B14_R7_EVIDENCE_DIR=\"${B14_R7_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-b14-r7-evidence.XXXXXX)}\" && node scripts/run-b14-r7-evidence-gates.mjs",
  "package:b14-r4": "node scripts/assemble-b14-r4-package.mjs",
  "package:b14-r5": "node scripts/assemble-b14-r5-package.mjs",
  "package:b14-r6": "node scripts/assemble-b14-r6-package.mjs",
  "package:b14-r7": "node scripts/assemble-b14-r7-package.mjs",
    "package:b14-r3": "node scripts/assemble-b14-r3-package.mjs",
    "package:b13-r4": "node scripts/assemble-b13-r4-package.mjs",
    "verify:package-consistency": "node scripts/verify-package-consistency.mjs",
    "verify:b12": "node scripts/run-b12-evidence-gates.mjs && node scripts/generate-b12-acceptance.mjs",
    "verify:product-ux": "node scripts/verify-product-ux.mjs && node --test tests/product-ux-copy.test.mjs tests/product-ux-gate.test.mjs && vitest run tests/store/product-ux-presentation.test.ts tests/store/b11-assistant-presentation.test.ts tests/store/b12-retcon-ux.test.ts tests/store/r1r1-boundary-evidence.test.ts",
    "verify:post-b14-ui-r5": "node scripts/run-post-b14-ui-r5-evidence.mjs",
    "package:post-b14-ui-r5": "node scripts/assemble-post-b14-ui-r5-package.mjs",
    "verify:post-b14-ui-r6": "node scripts/run-post-b14-ui-r6-evidence.mjs",
    "package:post-b14-ui-r6": "node scripts/assemble-post-b14-ui-r6-package.mjs",
    "verify:post-b14-ui-r7": "node scripts/run-post-b14-ui-r7-evidence.mjs",
    "package:post-b14-ui-r7": "node scripts/assemble-post-b14-ui-r7-package.mjs",
    "verify:post-b14-ui-r8": "export POST_B14_UI_R8_EVIDENCE_DIR=\"${POST_B14_UI_R8_EVIDENCE_DIR:-$(mktemp -d /tmp/moheng-post-b14-ui-r8-evidence.XXXXXX)}\" && node scripts/run-post-b14-ui-r8-certification.mjs",
    "package:post-b14-ui-r8": "node scripts/assemble-post-b14-ui-r8-package.mjs"
