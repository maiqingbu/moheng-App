{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/replan-escalation/output.schema.json",
  "title": "S41 重规划与升级决策 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S41"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "advisory_level",
        "creative_reason",
        "affected_quality_dimensions",
        "candidate_scope",
        "estimated_creative_cost",
        "runtime_action_hint",
        "human_question"
      ],
      "properties": {
        "advisory_level": {
          "description": "v1.2 architecture-aligned creative payload `advisory_level`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "creative_reason": {
          "description": "v1.2 architecture-aligned creative payload `creative_reason`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "affected_quality_dimensions": {
          "description": "v1.2 architecture-aligned creative payload `affected_quality_dimensions`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "candidate_scope": {
          "description": "v1.2 architecture-aligned creative payload `candidate_scope`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "estimated_creative_cost": {
          "description": "v1.2 architecture-aligned creative payload `estimated_creative_cost`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "runtime_action_hint": {
          "description": "v1.2 architecture-aligned creative payload `runtime_action_hint`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "human_question": {
          "description": "v1.2 architecture-aligned creative payload `human_question`；精确子类型在 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
