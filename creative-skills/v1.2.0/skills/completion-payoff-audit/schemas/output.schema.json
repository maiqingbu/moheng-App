{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/completion-payoff-audit/output.schema.json",
  "title": "S45 完结与回报审计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S45"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "payoff_findings",
        "reader_promise_coverage",
        "character_arc_payoff",
        "emotional_closure",
        "creative_gaps",
        "quality_assessment"
      ],
      "properties": {
        "payoff_findings": {
          "description": "v1.2 architecture-aligned creative payload `payoff_findings`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "reader_promise_coverage": {
          "description": "v1.2 architecture-aligned creative payload `reader_promise_coverage`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "character_arc_payoff": {
          "description": "v1.2 architecture-aligned creative payload `character_arc_payoff`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "emotional_closure": {
          "description": "v1.2 architecture-aligned creative payload `emotional_closure`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "creative_gaps": {
          "description": "v1.2 architecture-aligned creative payload `creative_gaps`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "quality_assessment": {
          "description": "v1.2 architecture-aligned creative payload `quality_assessment`；精确子类型在 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
