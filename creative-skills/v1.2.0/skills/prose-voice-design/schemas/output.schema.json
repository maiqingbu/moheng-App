{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/prose-voice-design/output.schema.json",
  "title": "S32 文风与叙述声音设计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S32"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "voice_targets",
        "sentence_rhythm",
        "lexical_density",
        "imagery_policy",
        "humor_register",
        "taboos",
        "variation"
      ],
      "properties": {
        "voice_targets": {
          "description": "BUILD_SPEC 要求的 voice_targets；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "sentence_rhythm": {
          "description": "BUILD_SPEC 要求的 sentence_rhythm；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "lexical_density": {
          "description": "BUILD_SPEC 要求的 lexical_density；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "imagery_policy": {
          "description": "BUILD_SPEC 要求的 imagery_policy；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "humor_register": {
          "description": "BUILD_SPEC 要求的 humor_register；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "taboos": {
          "description": "BUILD_SPEC 要求的 taboos；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "variation": {
          "description": "BUILD_SPEC 要求的 variation；精确子类型待 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
