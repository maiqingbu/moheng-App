{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/central-conflict-stakes-design/output.schema.json",
  "title": "S08 核心冲突与代价设计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S08"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "conflict_engine",
        "opposition_sources",
        "stakes_layers",
        "cost_model",
        "escalation_axes",
        "forced_choices"
      ],
      "properties": {
        "conflict_engine": {
          "description": "BUILD_SPEC 要求的 conflict_engine；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "opposition_sources": {
          "description": "BUILD_SPEC 要求的 opposition_sources；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "stakes_layers": {
          "description": "BUILD_SPEC 要求的 stakes_layers；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "cost_model": {
          "description": "BUILD_SPEC 要求的 cost_model；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "escalation_axes": {
          "description": "BUILD_SPEC 要求的 escalation_axes；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "forced_choices": {
          "description": "BUILD_SPEC 要求的 forced_choices；精确子类型待 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
