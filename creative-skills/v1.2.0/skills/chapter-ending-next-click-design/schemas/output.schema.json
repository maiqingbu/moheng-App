{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/chapter-ending-next-click-design/output.schema.json",
  "title": "S14 章节结尾与继续阅读动机设计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S14"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "ending_mode",
        "open_question",
        "new_cost",
        "decision_pressure",
        "payoff_or_reversal",
        "next_click_reason"
      ],
      "properties": {
        "ending_mode": {
          "description": "BUILD_SPEC 要求的 ending_mode；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "open_question": {
          "description": "BUILD_SPEC 要求的 open_question；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "new_cost": {
          "description": "BUILD_SPEC 要求的 new_cost；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "decision_pressure": {
          "description": "BUILD_SPEC 要求的 decision_pressure；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "payoff_or_reversal": {
          "description": "BUILD_SPEC 要求的 payoff_or_reversal；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "next_click_reason": {
          "description": "BUILD_SPEC 要求的 next_click_reason；精确子类型待 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
