{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/protagonist-design/output.schema.json",
  "title": "S03 主角设计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S03"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "identity_core",
        "want",
        "need_or_gap",
        "strengths",
        "flaws",
        "contradictions",
        "agency_engine",
        "growth_space"
      ],
      "properties": {
        "identity_core": {
          "description": "BUILD_SPEC 要求的 identity_core；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "want": {
          "description": "BUILD_SPEC 要求的 want；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "need_or_gap": {
          "description": "BUILD_SPEC 要求的 need_or_gap；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "strengths": {
          "description": "BUILD_SPEC 要求的 strengths；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "flaws": {
          "description": "BUILD_SPEC 要求的 flaws；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "contradictions": {
          "description": "BUILD_SPEC 要求的 contradictions；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "agency_engine": {
          "description": "BUILD_SPEC 要求的 agency_engine；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "growth_space": {
          "description": "BUILD_SPEC 要求的 growth_space；精确子类型待 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
