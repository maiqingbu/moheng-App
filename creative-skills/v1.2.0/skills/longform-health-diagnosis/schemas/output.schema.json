{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/longform-health-diagnosis/output.schema.json",
  "title": "S43 长篇健康诊断 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S43"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "quality_health_report",
        "soft_drifts",
        "trend_evidence",
        "creative_change_proposals",
        "urgency"
      ],
      "properties": {
        "quality_health_report": {
          "description": "v1.2 architecture-aligned creative payload `quality_health_report`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "soft_drifts": {
          "description": "v1.2 architecture-aligned creative payload `soft_drifts`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "trend_evidence": {
          "description": "v1.2 architecture-aligned creative payload `trend_evidence`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "creative_change_proposals": {
          "description": "v1.2 architecture-aligned creative payload `creative_change_proposals`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "urgency": {
          "description": "v1.2 architecture-aligned creative payload `urgency`；精确子类型在 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
