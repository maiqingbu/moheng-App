{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/pacing-rhythm-design/output.schema.json",
  "title": "S21 节奏与密度设计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S21"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "rhythm_plan",
        "intensity_curve",
        "recovery_windows",
        "exposition_budget",
        "payoff_spacing",
        "variation_rules"
      ],
      "properties": {
        "rhythm_plan": {
          "description": "BUILD_SPEC 要求的 rhythm_plan；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "intensity_curve": {
          "description": "BUILD_SPEC 要求的 intensity_curve；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "recovery_windows": {
          "description": "BUILD_SPEC 要求的 recovery_windows；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "exposition_budget": {
          "description": "BUILD_SPEC 要求的 exposition_budget；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "payoff_spacing": {
          "description": "BUILD_SPEC 要求的 payoff_spacing；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "variation_rules": {
          "description": "BUILD_SPEC 要求的 variation_rules；精确子类型待 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
