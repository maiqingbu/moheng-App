{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/worldbuilding-rule-design/output.schema.json",
  "title": "S06 世界观与硬规则设计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S06"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "hard_rules",
        "soft_assumptions",
        "institutions",
        "scarcity",
        "costs",
        "forbidden_breaks",
        "expansion_slots"
      ],
      "properties": {
        "hard_rules": {
          "description": "BUILD_SPEC 要求的 hard_rules；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "soft_assumptions": {
          "description": "BUILD_SPEC 要求的 soft_assumptions；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "institutions": {
          "description": "BUILD_SPEC 要求的 institutions；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "scarcity": {
          "description": "BUILD_SPEC 要求的 scarcity；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "costs": {
          "description": "BUILD_SPEC 要求的 costs；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "forbidden_breaks": {
          "description": "BUILD_SPEC 要求的 forbidden_breaks；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "expansion_slots": {
          "description": "BUILD_SPEC 要求的 expansion_slots；精确子类型待 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
