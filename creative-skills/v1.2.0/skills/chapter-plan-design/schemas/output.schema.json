{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/chapter-plan-design/output.schema.json",
  "title": "S25 章节计划设计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S25"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "creative_objectives",
        "scene_emphasis_options",
        "choice_pressure",
        "payoff_opportunities",
        "pacing_options",
        "renderer_hints"
      ],
      "properties": {
        "creative_objectives": {
          "description": "v1.2 architecture-aligned creative payload `creative_objectives`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "scene_emphasis_options": {
          "description": "v1.2 architecture-aligned creative payload `scene_emphasis_options`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "choice_pressure": {
          "description": "v1.2 architecture-aligned creative payload `choice_pressure`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "payoff_opportunities": {
          "description": "v1.2 architecture-aligned creative payload `payoff_opportunities`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "pacing_options": {
          "description": "v1.2 architecture-aligned creative payload `pacing_options`；精确子类型在 B10 Skill Runtime contract 冻结。"
        },
        "renderer_hints": {
          "description": "v1.2 architecture-aligned creative payload `renderer_hints`；精确子类型在 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
