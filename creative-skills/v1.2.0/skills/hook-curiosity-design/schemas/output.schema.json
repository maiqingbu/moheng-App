{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moheng://creative-skills/hook-curiosity-design/output.schema.json",
  "title": "S10 Hook 与好奇缺口设计 SkillResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "skillVersion",
    "bundleDigest",
    "taskId",
    "status",
    "sourceRefs",
    "assumptions",
    "payload",
    "findings",
    "contextRefs",
    "runtimeCheckRequests",
    "confidence",
    "nextSkillHints"
  ],
  "properties": {
    "skillId": {
      "const": "S10"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "NOT_APPLICABLE",
        "ADVISORY_ESCALATION"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "hook_type",
        "reader_questions",
        "information_gap",
        "stakes_signal",
        "payoff_window",
        "failure_modes"
      ],
      "properties": {
        "hook_type": {
          "description": "BUILD_SPEC 要求的 hook_type；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "reader_questions": {
          "description": "BUILD_SPEC 要求的 reader_questions；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "information_gap": {
          "description": "BUILD_SPEC 要求的 information_gap；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "stakes_signal": {
          "description": "BUILD_SPEC 要求的 stakes_signal；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "payoff_window": {
          "description": "BUILD_SPEC 要求的 payoff_window；精确子类型待 B10 Skill Runtime contract 冻结。"
        },
        "failure_modes": {
          "description": "BUILD_SPEC 要求的 failure_modes；精确子类型待 B10 Skill Runtime contract 冻结。"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nextSkillHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project fact/evidence refs supplied by Runtime; Skill may not fetch outside this context."
    },
    "runtimeCheckRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason",
          "refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CANON_CONFLICT",
              "KNOWLEDGE_BOUNDARY",
              "THREAD_STATE",
              "TASK_REALITY",
              "RESERVATION",
              "INTEGRITY",
              "PLAN_STALE",
              "EVIDENCE_GAP"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Advisory requests for deterministic Runtime/Support Harness checks; never a HARD decision."
    }
  }
}
