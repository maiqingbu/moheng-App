{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨衡",
  "version": "0.1.0",
  "identifier": "com.moheng.ai-novel-production-system",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "墨衡 · AI 小说生产系统",
        "width": 1440,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
