{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m0a://schemas/artifact/artifact-scope.schema.json",
  "title": "ArtifactScope",
  "type": "object",
  "properties": {
    "level": { "$ref": "../shared/definitions.schema.json#/$defs/ArtifactScopeLevel" },
    "bookId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" },
    "volumeId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" },
    "arcId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" },
    "chapterId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" },
    "sceneId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" },
    "entityId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" },
    "platformId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" }
  },
  "required": ["level"],
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "level": { "const": "PROJECT" } } }, "then": { "not": { "anyOf": [{ "required": ["bookId"] }, { "required": ["volumeId"] }, { "required": ["arcId"] }, { "required": ["chapterId"] }, { "required": ["sceneId"] }, { "required": ["entityId"] }] } } },
    { "if": { "properties": { "level": { "const": "BOOK" } } }, "then": { "required": ["bookId"] } },
    { "if": { "properties": { "level": { "const": "VOLUME" } } }, "then": { "required": ["volumeId"] } },
    { "if": { "properties": { "level": { "const": "ARC" } } }, "then": { "required": ["arcId"] } },
    { "if": { "properties": { "level": { "const": "CHAPTER" } } }, "then": { "required": ["chapterId"] } },
    { "if": { "properties": { "level": { "const": "SCENE" } } }, "then": { "required": ["sceneId", "chapterId"] } },
    { "if": { "properties": { "level": { "const": "ENTITY" } } }, "then": { "required": ["entityId"] } }
  ]
}
