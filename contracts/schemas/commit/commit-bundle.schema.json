{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m0a://schemas/commit/commit-bundle.schema.json",
  "title": "CommitBundle",
  "type": "object",
  "properties": {
    "commitId": {
      "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId"
    },
    "projectId": {
      "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId"
    },
    "commandId": {
      "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId"
    },
    "idempotencyKey": {
      "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId"
    },
    "expectedProjectRevision": {
      "type": "integer",
      "minimum": 0
    },
    "contractVersion": {
      "$ref": "../shared/definitions.schema.json#/$defs/CommandContractVersion"
    },
    "createdAt": {
      "$ref": "../shared/definitions.schema.json#/$defs/Rfc3339Utc"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "../artifact/artifact-envelope.schema.json"
      },
      "uniqueItems": true,
      "x-uniqueBy": "artifactId"
    },
    "headUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactType": {
            "$ref": "../shared/definitions.schema.json#/$defs/ArtifactType"
          },
          "scope": {
            "$ref": "../artifact/artifact-scope.schema.json"
          },
          "artifactId": {
            "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "payloadHash": {
            "$ref": "../shared/definitions.schema.json#/$defs/Sha256"
          }
        },
        "required": [
          "artifactType",
          "scope",
          "artifactId",
          "version",
          "payloadHash"
        ],
        "additionalProperties": false
      }
    },
    "canonDelta": {
      "type": "array",
      "items": { "$ref": "deltas.schema.json#/$defs/CanonDelta" }
    },
    "obligationDelta": {
      "type": "array",
      "items": { "$ref": "deltas.schema.json#/$defs/ObligationDelta" }
    },
    "foreshadowDelta": {
      "type": "array",
      "items": { "$ref": "deltas.schema.json#/$defs/ForeshadowDelta" }
    },
    "knowledgeDelta": {
      "type": "array",
      "items": { "$ref": "deltas.schema.json#/$defs/KnowledgeDelta" }
    },
    "stateDelta": {
      "type": "array",
      "items": { "$ref": "deltas.schema.json#/$defs/StateDelta" }
    },
    "dependencyEdges": {
      "type": "array",
      "items": { "$ref": "deltas.schema.json#/$defs/DependencyEdge" }
    },
    "jobUpdates": {
      "type": "array",
      "items": { "$ref": "deltas.schema.json#/$defs/JobUpdate" }
    },
    "decisionUpdates": {
      "type": "array",
      "items": { "$ref": "deltas.schema.json#/$defs/DecisionUpdate" }
    },
    "gateCertificates": {
      "type": "array",
      "items": { "$ref": "gate-certificate.schema.json" }
    }
  },
  "required": [
    "commitId",
    "projectId",
    "commandId",
    "idempotencyKey",
    "contractVersion",
    "createdAt",
    "artifacts"
  ],
  "additionalProperties": false
}
