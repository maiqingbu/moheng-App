{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m0a://schemas/commit/gate-certificate.schema.json",
  "title": "GateCertificate",
  "type": "object",
  "properties": {
    "certificateId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" },
    "projectId": { "$ref": "../shared/definitions.schema.json#/$defs/OpaqueId" },
    "gatePolicyRef": { "$ref": "../artifact/artifact-ref.schema.json" },
    "subjectRef": { "$ref": "../artifact/artifact-ref.schema.json" },
    "evidenceRefs": { "type": "array", "items": { "$ref": "../artifact/artifact-ref.schema.json" } },
    "sourceDigest": { "$ref": "../shared/definitions.schema.json#/$defs/Sha256" },
    "passedAt": { "$ref": "../shared/definitions.schema.json#/$defs/Rfc3339Utc" },
    "certificateDigest": { "$ref": "../shared/definitions.schema.json#/$defs/Sha256" }
  },
  "required": ["certificateId", "projectId", "gatePolicyRef", "subjectRef", "evidenceRefs", "sourceDigest", "passedAt", "certificateDigest"],
  "additionalProperties": false
}
