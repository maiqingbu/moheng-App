{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m0a://schemas/narrative/narrative-definitions.schema.json",
  "title": "NarrativeDefinitions",
  "$defs": {
    "GoalConstraint": { "type":"object", "properties": { "id": {"type":"string","minLength":1}, "description": {"type":"string","minLength":1} }, "required":["id","description"], "additionalProperties":false },
    "MacroDirection": { "type":"object", "properties": { "id": {"type":"string","minLength":1}, "description": {"type":"string","minLength":1} }, "required":["id","description"], "additionalProperties":false },
    "FutureReservation": { "type":"object", "properties": { "reservationId":{"type":"string","minLength":1}, "description":{"type":"string","minLength":1}, "reservedForVolumeNo":{"type":["integer","null"],"minimum":1}, "reservedForVolumeId":{"type":["string","null"],"minLength":1}, "notBeforeVolumeNo":{"type":["integer","null"],"minimum":1}, "prerequisites":{"type":"array","items":{"type":"string"}}, "mayForeshadow":{"type":"boolean"}, "mayReveal":{"type":"boolean"}, "authorityLevel":{"type":"string","enum":["A","B"]} }, "required":["reservationId","description","prerequisites","mayForeshadow","mayReveal","authorityLevel"], "additionalProperties":false },
    "VolumeIntentSeed": { "type":"object", "properties": { "seedId":{"type":"string","minLength":1}, "description":{"type":"string","minLength":1} }, "required":["seedId","description"], "additionalProperties":false },
    "Condition": { "type":"object", "properties": { "kind":{"type":"string","minLength":1}, "value":{} }, "required":["kind"], "additionalProperties":false },
    "TaskStatus": { "type":"string","enum":["NOT_STARTED","ACTIVE","SATISFIED","BLOCKED","INVALIDATED"] },
    "VolumeTask": { "type":"object", "properties": { "taskId":{"type":"string","minLength":1}, "class":{"type":"string","enum":["REQUIRED","OPTIONAL","FLEXIBLE","CLIMAX","RESERVED"]}, "objective":{"type":"string","minLength":1}, "dependsOnTaskIds":{"type":"array","items":{"type":"string"}}, "continuityThreadRefs":{"type":"array","items":{"type":"string"}}, "reservationRefs":{"type":"array","items":{"type":"string"}}, "completionPredicate":{"$ref":"#/$defs/Condition"}, "estimatedChapterCost":{"type":"object","properties":{"min":{"type":["integer","null"],"minimum":1},"preferred":{"type":"integer","minimum":1},"max":{"type":["integer","null"],"minimum":1}},"required":["preferred"],"additionalProperties":false}, "earliestPressure":{"type":["number","null"]}, "latestPressure":{"type":["number","null"]} }, "required":["taskId","class","objective","dependsOnTaskIds","continuityThreadRefs","reservationRefs","completionPredicate","estimatedChapterCost"], "additionalProperties":false },
    "SourceRef": { "type":"object", "properties": { "kind":{"type":"string","minLength":1}, "ref":{"type":"string","minLength":1} }, "required":["kind","ref"], "additionalProperties":false },
    "EvidenceRef": { "type":"object", "properties": { "artifactId":{"type":"string","minLength":1}, "version":{"type":"integer","minimum":1}, "rangeStart":{"type":["integer","null"],"minimum":0}, "rangeEnd":{"type":["integer","null"],"minimum":0}, "quote":{"type":["string","null"]} }, "required":["artifactId","version"], "additionalProperties":false },
    "OmittedSource": { "type":"object", "properties": { "sourceRef":{"$ref":"#/$defs/SourceRef"}, "reason":{"type":"string","minLength":1} }, "required":["sourceRef","reason"], "additionalProperties":false },
    "HorizonSlot": { "type":"object", "properties": { "slotNo":{"type":"integer","minimum":1}, "objective":{"type":"string","minLength":1}, "tentative":{"const":true} }, "required":["slotNo","objective","tentative"], "additionalProperties":false },
    "ContinuityThreadProjection": { "type":"object", "properties": { "threadId":{"type":"string","minLength":1}, "status":{"type":"string","enum":["OPEN","SUSPENDED","RESOLVED","ABANDONED"]}, "threadClass":{"type":"string","minLength":1}, "sourceEventId":{"type":["string","null"]}, "evidenceRefs":{"type":"array","items":{"$ref":"#/$defs/EvidenceRef"}}, "authorityLevel":{"type":"string","enum":["A","B","C"]} }, "required":["threadId","status","threadClass","evidenceRefs","authorityLevel"], "additionalProperties":false },
    "VolumeProgressProjection": { "type":"object", "properties": { "volumeId":{"type":"string","minLength":1}, "activeTaskIds":{"type":"array","items":{"type":"string"}}, "blockedTaskIds":{"type":"array","items":{"type":"string"}}, "remainingChapterCapacity":{"type":"integer","minimum":0}, "planningPressure":{"type":"object"}, "generatedRevision":{"type":"integer","minimum":0} }, "required":["volumeId","activeTaskIds","blockedTaskIds","remainingChapterCapacity","planningPressure","generatedRevision"], "additionalProperties":false },
    "TaskProgress": { "type":"object", "properties": { "taskId":{"type":"string","minLength":1}, "status":{"$ref":"#/$defs/TaskStatus"}, "lastAdvancedChapterId":{"type":["string","null"]}, "evidenceRefs":{"type":"array","items":{"$ref":"#/$defs/EvidenceRef"}}, "remainingConditions":{"type":"array","items":{"$ref":"#/$defs/Condition"}}, "metric":{"type":["object","null"],"properties":{"current":{"type":"integer","minimum":0},"target":{"type":"integer","minimum":1}},"required":["current","target"],"additionalProperties":false} }, "required":["taskId","status","evidenceRefs","remainingConditions"], "additionalProperties":false }
  }
}
