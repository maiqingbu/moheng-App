{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"m0a://schemas/narrative/book-plan.r1.schema.json",
  "title":"BookPlanR1",
  "$comment":"globalLengthBudget is the canonical serialized representation of targetLengthRange; R1 stores one length authority.",
  "type":"object",
  "properties":{
    "payloadSchema":{"const":"book-plan.r1"},
    "planningMaturity":{"type":"string","enum":["SEED","APPROVED"]},
    "storyPromise":{"type":"string","minLength":1},
    "protagonistMacroDirection":{"type":"string","minLength":1},
    "endingBoundary":{"type":"string","minLength":1},
    "mustAchieve":{"type":"array","items":{"$ref":"narrative-definitions.schema.json#/$defs/GoalConstraint"}},
    "mustNotBreak":{"type":"array","items":{"$ref":"narrative-definitions.schema.json#/$defs/GoalConstraint"}},
    "relationshipMacroDirections":{"type":"array","items":{"$ref":"narrative-definitions.schema.json#/$defs/MacroDirection"}},
    "majorMysteryGoals":{"type":"array","items":{"$ref":"narrative-definitions.schema.json#/$defs/MacroDirection"}},
    "futureReservations":{"type":"array","items":{"$ref":"narrative-definitions.schema.json#/$defs/FutureReservation"}},
    "volumeIntentSeeds":{"type":"array","items":{"$ref":"narrative-definitions.schema.json#/$defs/VolumeIntentSeed"}},
    "openingHypotheses":{"type":"array","items":{"type":"string"}},
    "globalLengthBudget":{"type":"object","properties":{"minWords":{"type":["integer","null"],"minimum":1},"preferredWords":{"type":"integer","minimum":1},"maxWords":{"type":["integer","null"],"minimum":1}},"required":["preferredWords"],"additionalProperties":false}
  },
  "required":["payloadSchema","planningMaturity","storyPromise","protagonistMacroDirection","endingBoundary","mustNotBreak","openingHypotheses","globalLengthBudget"],
  "allOf":[{"if":{"properties":{"planningMaturity":{"const":"APPROVED"}}},"then":{"required":["mustAchieve","relationshipMacroDirections","majorMysteryGoals","futureReservations","volumeIntentSeeds"]}}],
  "additionalProperties":false
}
