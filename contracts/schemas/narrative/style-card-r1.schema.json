{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "m0a://schemas/narrative/style-card.r1.schema.json",
 "title": "StyleCardR1",
 "type": "object",
 "$defs": {
  "Range": {
   "type": "object",
   "properties": {
    "min": {
     "type": "number",
     "minimum": 0
    },
    "max": {
     "type": "number",
     "minimum": 0
    }
   },
   "required": [
    "min",
    "max"
   ],
   "additionalProperties": false
  }
 },
 "properties": {
  "payloadSchema": {
   "const": "style-card.r1"
  },
  "stage": {
   "type": "string",
   "enum": [
    "CANDIDATE",
    "CONFIRMED"
   ]
  },
  "generation": {
   "type": "integer",
   "minimum": 1
  },
  "variant": {
   "type": "string",
   "minLength": 1
  },
  "label": {
   "type": "string",
   "minLength": 1
  },
  "source": {
   "type": "object",
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "MARKET_ARCHETYPE",
      "USER_SAMPLE"
     ]
    },
    "archetypeIds": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "sampleDigest": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[a-f0-9]{64}$"
    }
   },
   "required": [
    "kind",
    "archetypeIds",
    "sampleDigest"
   ],
   "additionalProperties": false
  },
  "confirmedFromRef": {
   "anyOf": [
    {
     "$ref": "../artifact/artifact-ref.schema.json"
    },
    {
     "type": "null"
    }
   ]
  },
  "targets": {
   "type": "object",
   "properties": {
    "avgParagraphChars": {
     "$ref": "#/$defs/Range"
    },
    "shortParagraphPct": {
     "$ref": "#/$defs/Range"
    },
    "dialogueParagraphPct": {
     "$ref": "#/$defs/Range"
    },
    "similePer1k": {
     "$ref": "#/$defs/Range"
    },
    "explainPer1k": {
     "$ref": "#/$defs/Range"
    },
    "exclaimPer1k": {
     "$ref": "#/$defs/Range"
    },
    "questionPer1k": {
     "$ref": "#/$defs/Range"
    },
    "ellipsisPer1k": {
     "$ref": "#/$defs/Range"
    }
   },
   "required": [
    "avgParagraphChars",
    "shortParagraphPct",
    "dialogueParagraphPct",
    "similePer1k",
    "explainPer1k",
    "exclaimPer1k",
    "questionPer1k",
    "ellipsisPer1k"
   ],
   "additionalProperties": false
  },
  "narration": {
   "type": "object",
   "properties": {
    "person": {
     "type": "string",
     "enum": [
      "FIRST",
      "THIRD"
     ]
    },
    "povPolicy": {
     "type": "string",
     "enum": [
      "STRICT",
      "SHORT_CUTS_ALLOWED"
     ]
    },
    "voice": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "person",
    "povPolicy",
    "voice"
   ],
   "additionalProperties": false
  },
  "openingStructure": {
   "type": "array",
   "minItems": 3,
   "maxItems": 8,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "rules": {
   "type": "array",
   "minItems": 4,
   "maxItems": 10,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "forbidden": {
   "type": "array",
   "minItems": 1,
   "maxItems": 8,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "examples": {
   "type": "array",
   "maxItems": 4,
   "items": {
    "type": "object",
    "properties": {
     "technique": {
      "type": "string",
      "minLength": 1
     },
     "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "required": [
     "technique",
     "lines"
    ],
    "additionalProperties": false
   }
  },
  "createdAt": {
   "$ref": "../shared/definitions.schema.json#/$defs/Rfc3339Utc"
  }
 },
 "additionalProperties": false,
 "required": [
  "payloadSchema",
  "stage",
  "generation",
  "variant",
  "label",
  "source",
  "confirmedFromRef",
  "targets",
  "narration",
  "openingStructure",
  "rules",
  "forbidden",
  "examples",
  "createdAt"
 ]
}
