{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m0a://schemas/health/long-form-health-projection-r1.schema.json",
  "title": "LongFormHealthProjectionR1",
  "type": "object",
  "properties": {
    "payloadSchema": { "type": "string", "const": "long-form-health-projection.r1" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s]+$" },
    "projectRevision": { "type": "integer", "minimum": 0 },
    "checkedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "level": { "type": "string", "enum": ["healthy", "attention", "risk"] },
    "coverage": {
      "type": "object",
      "properties": {
        "totalFactors": { "type": "integer", "const": 8 },
        "evaluatedFactors": { "type": "integer", "minimum": 0, "maximum": 8 },
        "insufficientFactors": { "type": "integer", "minimum": 0, "maximum": 8 },
        "unavailableFactors": { "type": "integer", "minimum": 0, "maximum": 8 }
      },
      "required": ["totalFactors", "evaluatedFactors", "insufficientFactors", "unavailableFactors"],
      "additionalProperties": false
    },
    "factors": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "x-uniqueBy": "factorCode",
      "items": { "$ref": "#/$defs/HealthFactor" }
    },
    "issues": { "$ref": "#/$defs/HealthIssuesPage" },
    "counters": { "$ref": "#/$defs/HealthCounters" },
    "provenance": { "$ref": "#/$defs/HealthProvenance" }
  },
  "$defs": {
    "HealthSourceRef": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "ref"],
      "additionalProperties": false
    },
    "HealthFactor": {
      "type": "object",
      "properties": {
        "factorCode": { "type": "string", "enum": ["OBLIGATION_OVERDUE", "FORESHADOW_AGING", "ROUTE_DRIFT", "TASK_BLOCKAGE", "CONTEXT_GROWTH", "MODEL_COST_DRIFT", "READER_DESIRE", "QUALITY_DRIFT"] },
        "truthClass": { "type": "string", "enum": ["DETERMINISTIC_RUNTIME", "SOFT_ADVISORY"] },
        "status": { "type": "string", "enum": ["EVALUATED", "INSUFFICIENT_DATA", "SOURCE_UNAVAILABLE"] },
        "severity": { "type": "string", "enum": ["healthy", "attention", "risk"] },
        "summary": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/HealthSourceRef" } },
        "recommendedDestination": { "type": "string", "minLength": 1 }
      },
      "required": ["factorCode", "truthClass", "status", "severity", "summary", "detail", "sourceRefs", "recommendedDestination"],
      "additionalProperties": false
    },
    "HealthIssue": {
      "type": "object",
      "properties": {
        "issueId": { "type": "string", "minLength": 1 },
        "factorCode": { "type": "string", "enum": ["OBLIGATION_OVERDUE", "FORESHADOW_AGING", "ROUTE_DRIFT", "TASK_BLOCKAGE", "CONTEXT_GROWTH", "MODEL_COST_DRIFT", "READER_DESIRE", "QUALITY_DRIFT"] },
        "severity": { "type": "string", "enum": ["healthy", "attention", "risk"] },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "dueChapter": { "type": ["integer", "null"], "minimum": 0 },
        "recommendedDestination": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/HealthSourceRef" } }
      },
      "required": ["issueId", "factorCode", "severity", "title", "detail", "location", "recommendedDestination", "sourceRefs"],
      "additionalProperties": false
    },
    "HealthIssuesPage": {
      "type": "object",
      "properties": {
        "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/HealthIssue" } },
        "nextCursor": { "type": ["string", "null"] },
        "total": { "type": "integer", "minimum": 0 }
      },
      "required": ["items", "nextCursor", "total"],
      "additionalProperties": false
    },
    "HealthCoverage": {
      "type": "object",
      "properties": {
        "totalFactors": { "type": "integer", "const": 8 },
        "evaluatedFactors": { "type": "integer", "minimum": 0, "maximum": 8 },
        "insufficientFactors": { "type": "integer", "minimum": 0, "maximum": 8 },
        "unavailableFactors": { "type": "integer", "minimum": 0, "maximum": 8 }
      },
      "required": ["totalFactors", "evaluatedFactors", "insufficientFactors", "unavailableFactors"],
      "additionalProperties": false
    },
    "HealthCounters": {
      "type": "object",
      "properties": {
        "openObligations": { "type": "integer", "minimum": 0 },
        "overdueObligations": { "type": "integer", "minimum": 0 },
        "openForeshadows": { "type": "integer", "minimum": 0 },
        "overdueForeshadows": { "type": "integer", "minimum": 0 },
        "blockedRequiredTasks": { "type": "integer", "minimum": 0 },
        "blockedOptionalTasks": { "type": "integer", "minimum": 0 },
        "overdueReaderDesires": { "type": "integer", "minimum": 0 },
        "qualitySamples": { "type": "integer", "minimum": 0 },
        "comparableContextRuns": { "type": "integer", "minimum": 0 },
        "comparableCostRuns": { "type": "integer", "minimum": 0 }
      },
      "required": ["openObligations", "overdueObligations", "openForeshadows", "overdueForeshadows", "blockedRequiredTasks", "blockedOptionalTasks", "overdueReaderDesires", "qualitySamples", "comparableContextRuns", "comparableCostRuns"],
      "additionalProperties": false
    },
    "HealthProvenance": {
      "type": "object",
      "properties": {
        "queryMode": { "type": "string", "enum": ["ON_DEMAND"] },
        "cacheMode": { "type": "string", "enum": ["PROJECTION_ONLY", "NO_CACHE"] },
        "sourceRevision": { "type": "integer", "minimum": 0 },
        "bounded": { "type": "boolean", "const": true },
        "fullManuscriptScan": { "type": "boolean", "const": false },
        "factorSources": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/HealthSourceRef" } } }
      },
      "required": ["queryMode", "cacheMode", "sourceRevision", "bounded", "fullManuscriptScan", "factorSources"],
      "additionalProperties": false
    }
  },
  "required": ["payloadSchema", "projectId", "projectRevision", "checkedAt", "score", "level", "coverage", "factors", "issues", "counters", "provenance"],
  "additionalProperties": false
}
