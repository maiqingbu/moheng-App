{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "targeted repairs to first-volume antagonist pressure",
  "type": "object",
  "required": ["pressureCorrections"],
  "additionalProperties": false,
  "properties": {
    "pressureCorrections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["stage", "pressure"],
        "additionalProperties": false,
        "properties": {
          "stage": {"type": "integer", "minimum": 1, "maximum": 8},
          "pressure": {"type": "string", "minLength": 8, "maxLength": 160}
        }
      }
    }
  }
}
