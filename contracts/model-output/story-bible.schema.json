{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story bible candidates",
  "description": "Three story bibles. Style descriptions (humorStyle, innerVoiceStyle, speechStyle) describe a manner and never quote a line.",
  "type": "object",
  "required": [
    "bibles"
  ],
  "properties": {
    "bibles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "angle": {
            "type": "string",
            "minLength": 1
          },
          "normalWorld": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "object",
            "properties": {
              "experience": {
                "type": "string",
                "minLength": 1
              },
              "rules": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "properties": {
                    "rule": {
                      "type": "string",
                      "minLength": 1
                    },
                    "numbers": {
                      "type": "string",
                      "minLength": 1
                    },
                    "howReadersSeeIt": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "rule",
                    "numbers",
                    "howReadersSeeIt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "experience",
              "rules"
            ],
            "additionalProperties": false
          },
          "protagonist": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "personality": {
                "type": "string",
                "minLength": 1
              },
              "flaw": {
                "type": "string",
                "minLength": 1
              },
              "wantsNow": {
                "type": "string",
                "minLength": 1
              },
              "humorStyle": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^“”「」\"]*$"
              },
              "innerVoiceStyle": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^“”「」\"]*$"
              }
            },
            "required": [
              "name",
              "personality",
              "flaw",
              "wantsNow",
              "humorStyle",
              "innerVoiceStyle"
            ],
            "additionalProperties": false
          },
          "emotionalAnchor": {
            "type": "object",
            "properties": {
              "object": {
                "type": "string",
                "minLength": 1
              },
              "memorySummary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "object",
              "memorySummary"
            ],
            "additionalProperties": false
          },
          "antagonist": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "string",
                "minLength": 1
              },
              "wants": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "position",
              "wants",
              "method"
            ],
            "additionalProperties": false
          },
          "cast": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "type": "string",
                  "minLength": 1
                },
                "privateAgenda": {
                  "type": "string",
                  "minLength": 1
                },
                "speechStyle": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^“”「」\"]*$"
                },
                "contrastWithProtagonist": {
                  "type": "string",
                  "minLength": 1
                },
                "firstAppears": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "name",
                "role",
                "relation",
                "privateAgenda",
                "speechStyle",
                "contrastWithProtagonist",
                "firstAppears"
              ],
              "additionalProperties": false
            }
          },
          "openingArc": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "chapter": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "direction": {
                  "type": "string",
                  "minLength": 1
                },
                "protagonistWin": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "chapter",
                "direction",
                "protagonistWin"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "angle",
          "normalWorld",
          "mechanism",
          "protagonist",
          "emotionalAnchor",
          "antagonist",
          "cast",
          "openingArc"
        ],
        "additionalProperties": false
      }
    }
  }
}
