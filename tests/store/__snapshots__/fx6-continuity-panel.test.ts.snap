exports[`FX-6 continuity panel > fx6-continuity-panel-advanced-mode displays exact references for advanced users > continuity-panel-advanced-mode 1`] = `"<section data-v-31bc9a16="" class="card pad section continuity-projection" data-continuity-projection="REALITY"><div data-v-31bc9a16="" class="card-head"><div data-v-31bc9a16=""><h2 data-v-31bc9a16="" class="card-title">未完成剧情线</h2><p data-v-31bc9a16="" class="card-subtitle">只读呈现已记录的剧情责任、来源和当前处置。</p></div><span data-v-31bc9a16="" class="badge">REALITY · 投影</span></div><!--v-if--><!--v-if--><article data-v-31bc9a16="" class="continuity-thread"><div data-v-31bc9a16="" class="card-head"><div data-v-31bc9a16=""><strong data-v-31bc9a16="">剧情责任 · OPEN</strong><p data-v-31bc9a16="" class="muted continuity-description">林舟必须兑现门后的承诺。</p></div><span data-v-31bc9a16="" class="badge">A 级</span></div><dl data-v-31bc9a16="" class="pitch-kv"><div data-v-31bc9a16=""><dt data-v-31bc9a16="">来源事件</dt><dd data-v-31bc9a16="">来源章节正文（版本 1）：“林舟推开石门”</dd></div><div data-v-31bc9a16=""><dt data-v-31bc9a16="">兑现条件</dt><dd data-v-31bc9a16="">当人物或实体出现（entity:linzhou）</dd></div><div data-v-31bc9a16=""><dt data-v-31bc9a16="">当前处置</dt><dd data-v-31bc9a16="">继续推进</dd></div></dl><details data-v-31bc9a16="" class="continuity-evidence"><summary data-v-31bc9a16="">证据引文（1）</summary><blockquote data-v-31bc9a16=""><p data-v-31bc9a16="">“林舟推开石门”</p><small data-v-31bc9a16="" class="muted">artifact:chapter:1 · v1 · 字符 0–6</small></blockquote></details><dl data-v-31bc9a16="" class="pitch-kv advanced-continuity-refs"><div data-v-31bc9a16=""><dt data-v-31bc9a16="">sourceEventRef</dt><dd data-v-31bc9a16=""><code data-v-31bc9a16="">event:event:fact:opening-door</code></dd></div><div data-v-31bc9a16=""><dt data-v-31bc9a16="">sourceRefs</dt><dd data-v-31bc9a16=""><code data-v-31bc9a16="">[{"kind":"event","ref":"event:fact:opening-door"}]</code></dd></div></dl><div data-v-31bc9a16="" class="actions"><button data-v-31bc9a16="" class="btn" type="button">发起变更</button></d